# Local overrides — this file is gitignored.
#
# Network setup: this machine is 192.168.2.216 (LAN IP, from `ipconfig getifaddr en0`).
# Both servers bind 0.0.0.0 so the app is reachable from other devices on the LAN
# (phone, tablet, second laptop). Update this block and the URLs below if the
# machine's DHCP address changes.
#
#   Frontend  http://192.168.2.216:5174
#   Backend   https://mauryaapi.expertshub.in
#
# Use the LAN IP (not 127.0.0.1) for the API origin: a device loading the
# frontend over the LAN cannot reach this machine's loopback address.
VITE_PORT=5174
VITE_API_BASE_URL=/api/v1
VITE_ASSET_BASE_URL=https://mauryaapi.expertshub.in

# Realtime support chat (Laravel Reverb, run with `php artisan reverb:start` in
# backend/). Must match backend/.env's REVERB_* values.
#
# Use the LAN IP, not localhost: a device loading the frontend over the LAN
# cannot reach this machine's loopback address.
VITE_REVERB_APP_KEY=rus3ao48izmxxaxjcjge
VITE_REVERB_APP_ID=703039
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
