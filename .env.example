# Frontend dev-server configuration (Vite only — copy to `.env` and adjust).
#
# The React app and the Laravel API run as two independent servers on two
# ports. Nothing is proxied: the browser talks to the backend directly.

# Port the Vite dev server listens on.
VITE_PORT=5173

# Laravel API origin (php artisan serve). Absolute, so the frontend and the
# backend are addressed separately — this is what replaces the old /api proxy.
VITE_API_BASE_URL=https://mauryaapi.expertshub.in

# Origin that serves backend-owned static files (/uploads/...). The Laravel API
# returns absolute asset URLs, so this is only a fallback for rows that stored
# a bare path.
VITE_ASSET_BASE_URL=https://mauryaapi.expertshub.in

# Realtime support chat (Laravel Reverb, run with `php artisan reverb:start` in
# backend/). Copy the REVERB_APP_KEY / REVERB_HOST / REVERB_PORT values from the
# backend's .env so both halves agree.
#
# Use the machine's LAN address rather than localhost if other devices on the
# network will open the chat.
VITE_REVERB_APP_KEY=
VITE_REVERB_APP_ID=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
